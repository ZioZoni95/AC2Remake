; AC2Remake — progetto Godot 4. Gli asset (engines/godot/assets) NON sono nel repo: si rigenerano con
; pipeline/ac2_aircraft.py / ac2_mission.py e si copiano con tools/sync_godot_assets.sh.
config_version=5

[application]
config/name="AC2Remake"
run/main_scene="res://scenes/aircraft_viewer.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=960
window/size/viewport_height=540

[rendering]
renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=2
